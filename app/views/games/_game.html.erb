<div id="<%= dom_id game %>">
  <div>
    <strong>Title:</strong>
    <%= game.title %>
  </div>

  <div>
    <strong>Platform:</strong>
    <%= game.platform %>
  </div>

  <div>
    <strong>Status:</strong>
    <%= game.status %>
  </div>

  <div>
    <strong>Hours:</strong>
    <%= game.hours %>
  </div>

  <div>
    <strong>Note:</strong>
    <%= game.note %>
  </div>

</div>
